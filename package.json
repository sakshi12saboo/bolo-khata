{
  "name": "bolo-khata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-first billing and udhaar ledger for kirana stores",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "demo:record": "playwright test e2e/demo.spec.ts",
    "eval": "node scripts/eval.ts",
    "build:server": "vite build --ssr server/node-server.ts --outDir dist-server",
    "start": "node dist-server/node-server.js",
    "eval:holdout": "CASES=scripts/eval-holdout.json node scripts/eval.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
